{
  "type": "object",
  "required": ["routes", "components"],
  "properties": {
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "component", "key_text"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "key_text": {"type": "string", "minLength": 1}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "key_text"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "key_text": {"type": "string", "minLength": 1}
        }
      }
    },
    "data_model": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
