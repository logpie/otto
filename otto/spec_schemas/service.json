{
  "type": "object",
  "required": ["service_name", "health_checks"],
  "properties": {
    "service_name": {"type": "string", "minLength": 1},
    "health_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command_or_url", "success_observable"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command_or_url": {"type": "string", "minLength": 1},
          "success_observable": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime": {"type": "string"},
    "ports": {
      "type": "array",
      "items": {"type": "integer"}
    }
  }
}
