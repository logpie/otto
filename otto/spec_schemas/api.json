{
  "type": "object",
  "required": ["base_path", "endpoints"],
  "properties": {
    "base_path": {"type": "string", "minLength": 1},
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "path", "summary", "response_shape"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "response_shape": {"type": "string", "minLength": 1},
          "auth": {"type": "string"}
        }
      }
    },
    "data_model": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
